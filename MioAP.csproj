<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
		<PackageReference Include="Archipelago.MultiClient.Net.Analyzers" Version="2.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

		<!-- Compile against it, ship none of it: the loader has its own copy of
		     PolyHook2.NET.dll and the natives behind it (PolyHook_2, cpolyhook2,
		     asmjit, asmtk, Zydis) and loads them before we're initialized. A
		     second set in the mod folder is at best ignored - Windows hands back
		     the already-loaded module for a given name - and at worst a version
		     mismatch against the managed binding the loader actually used.
		     Excluding "runtime" drops PolyHook2.NET.dll, "native" drops the
		     runtimes\win-x64\native\ payload. -->
		<PackageReference Include="PolyHook2.NET" Version="1.1.3" ExcludeAssets="runtime;native" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="MioModdingApi">
			<HintPath>../lib/MioModdingApi.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="MioModLoader">
			<HintPath>../lib/MioModLoader.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="MioBinds">
			<HintPath>../lib/MioBinds.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- A no-op now that PolyHook's natives are excluded, but kept as a safety
	     net: if a future package does ship natives, post-build.bat's flat *.dll
	     glob would miss them in runtimes\. -->
	<Target Name="FlattenNativeAssets" BeforeTargets="PostBuild">
		<ItemGroup>
			<NativeAsset Include="$(TargetDir)runtimes\win-x64\native\*.dll" />
			<NativeAsset Include="$(TargetDir)runtimes\win\native\*.dll" />
		</ItemGroup>

		<Copy SourceFiles="@(NativeAsset)"
			  DestinationFolder="$(TargetDir)"
			  SkipUnchangedFiles="true" />

		<Message Importance="high"
				 Text="Flattened native: %(NativeAsset.Filename)%(NativeAsset.Extension)" />
	</Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="call &quot;$(ProjectDir)post-build.bat&quot; &quot;$(TargetPath)&quot; &quot;$(ProjectName)&quot; &quot;$(TargetDir)&quot;" WorkingDirectory="$(ProjectDir)" />
	</Target>

	<PropertyGroup>
		<!-- CI=true on GitHub Actions, where there is no game to deploy into. -->
		<DeployToGame Condition="'$(DeployToGame)' == '' And '$(CI)' == 'true'">false</DeployToGame>
		<DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
		<GameModsDir Condition="'$(GameModsDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\MIO\mods\MioAP</GameModsDir>
	</PropertyGroup>

	<Target Name="DeployToGame" AfterTargets="PostBuild" Condition="'$(DeployToGame)' == 'true'">
		<PropertyGroup>
			<StageDir>$(ProjectDir)bin\$(ProjectName)</StageDir>
		</PropertyGroup>

		<!-- /XF keeps saved_connections.json out of the mirror entirely: it is
		     written by the mod at runtime, so it must survive both the overwrite
		     and the /MIR delete pass that would otherwise purge it as an extra. -->
		<Exec Command="robocopy &quot;$(StageDir)&quot; &quot;$(GameModsDir)&quot; /MIR /XF saved_connections.json /NFL /NDL /NJH /NJS /NP"
			  IgnoreExitCode="true"
			  ContinueOnError="true">
			<Output TaskParameter="ExitCode" PropertyName="RobocopyExit" />
		</Exec>

		<Warning Condition="'$(RobocopyExit)' &gt;= 8"
				 Text="Deploy to &quot;$(GameModsDir)&quot; failed (robocopy $(RobocopyExit)). Is the game running?" />
		<Message Condition="'$(RobocopyExit)' &lt; 8" Importance="high"
				 Text="Deployed to $(GameModsDir)" />
	</Target>
</Project>